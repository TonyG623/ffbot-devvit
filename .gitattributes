# Normalise to LF in the repo and on checkout. Without this, core.autocrlf=true
# on Windows checks files out with CRLF while biome formats to LF, so `npm run
# lint` fails on a clean clone -- and since lint is part of `npm test`, and
# playtest.cmd refuses to deploy when `npm test` fails, a fresh clone could not
# deploy at all.
* text=auto eol=lf

# Batch files are the exception: cmd.exe can mis-handle labels and goto in a
# file with LF endings, so these stay CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf
